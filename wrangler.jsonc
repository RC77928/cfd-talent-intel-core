{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cfd-talent-intel-core",
  "compatibility_date": "2026-04-01",
  "main": "_worker.js",
  "assets": {
    "directory": "./data",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
